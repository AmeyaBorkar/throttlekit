{
  "__comment": "Reference Grafana dashboard for ThrottleKit's OpenTelemetry metrics (see docs/METRICS.md). Assumes a Prometheus datasource scraping an OTel exporter: throttlekit.checks -> throttlekit_checks_total, histograms expose _bucket/_sum/_count. If your exporter appends a unit suffix to the latency histogram (e.g. throttlekit_store_latency_milliseconds_bucket), adjust the 'Store latency' panel's metric name. Import via Dashboards -> New -> Import.",
  "uid": "throttlekit-overview",
  "title": "ThrottleKit — Rate limiting",
  "tags": ["throttlekit", "rate-limiting"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "strategy",
        "label": "Strategy",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(throttlekit_checks_total, strategy)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Checks/sec by outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (allowed) (rate(throttlekit_checks_total{strategy=~\"$strategy\"}[$__rate_interval]))",
          "legendFormat": "allowed={{allowed}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deny rate",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(throttlekit_checks_total{allowed=\"false\",strategy=~\"$strategy\"}[$__rate_interval])) / clamp_min(sum(rate(throttlekit_checks_total{strategy=~\"$strategy\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "deny rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Remaining headroom (p50 / p99)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(throttlekit_remaining_bucket{strategy=~\"$strategy\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(throttlekit_remaining_bucket{strategy=~\"$strategy\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Store latency (p50 / p99, ms)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(throttlekit_store_latency_bucket{strategy=~\"$strategy\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(throttlekit_store_latency_bucket{strategy=~\"$strategy\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Adaptive concurrency — limit vs in-flight",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "throttlekit_concurrency_limit",
          "legendFormat": "limit"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "throttlekit_concurrency_inflight",
          "legendFormat": "inflight"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Adaptive concurrency — no-load RTT baseline",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "throttlekit_concurrency_rtt_noload",
          "legendFormat": "rtt_noload"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Denials by binding axis (which axis is throttling)",
      "description": "Unified-admission denials split by the binding lane — rate / concurrency / cost, or 'policy' (the joint-LP bid-price filter). The axis breakdown no span facet can be. Requires wrapping a unifiedAdmission with instrumentAdmitter (throttlekit/otel, 1.2.0+).",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (lane) (rate(throttlekit_denies_by_axis_total[$__rate_interval]))",
          "legendFormat": "{{lane}}"
        }
      ]
    }
  ]
}
