{
  "name": "throttlekit",
  "version": "0.4.0",
  "description": "Pluggable, framework-agnostic rate limiting for Node and the web: GCRA by default, isomorphic JS/Lua dual-path, two-tier token leasing, multi-dimensional single-round-trip checks, and adaptive concurrency.",
  "type": "module",
  "license": "MIT",
  "author": "Ameya Borkar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmeyaBorkar/throttlekit.git"
  },
  "homepage": "https://github.com/AmeyaBorkar/throttlekit#readme",
  "bugs": {
    "url": "https://github.com/AmeyaBorkar/throttlekit/issues"
  },
  "keywords": [
    "rate-limit",
    "rate-limiter",
    "ratelimit",
    "gcra",
    "token-bucket",
    "leaky-bucket",
    "sliding-window",
    "fixed-window",
    "redis",
    "postgres",
    "postgresql",
    "lua",
    "throttle",
    "backpressure",
    "adaptive-concurrency",
    "express",
    "fastify",
    "koa",
    "hono",
    "nextjs",
    "middleware",
    "fetch",
    "edge",
    "cloudflare-workers",
    "ddos"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.ts",
        "default": "./dist/redis.js"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      },
      "require": {
        "types": "./dist/fetch.d.cts",
        "default": "./dist/fetch.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./koa": {
      "import": {
        "types": "./dist/koa.d.ts",
        "default": "./dist/koa.js"
      },
      "require": {
        "types": "./dist/koa.d.cts",
        "default": "./dist/koa.cjs"
      }
    },
    "./otel": {
      "import": {
        "types": "./dist/otel.d.ts",
        "default": "./dist/otel.js"
      },
      "require": {
        "types": "./dist/otel.d.cts",
        "default": "./dist/otel.cjs"
      }
    },
    "./testkit": {
      "import": {
        "types": "./dist/testkit.d.ts",
        "default": "./dist/testkit.js"
      },
      "require": {
        "types": "./dist/testkit.d.cts",
        "default": "./dist/testkit.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "bench": "tsx bench/run.ts",
    "bench:compare": "tsx bench/compare.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@opentelemetry/api": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/koa": "^3.0.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "fast-check": "^3.23.1",
    "fastify": "^5.8.5",
    "hono": "^4.12.23",
    "ioredis": "^5.4.2",
    "koa": "^3.2.1",
    "pg": "^8.21.0",
    "rate-limiter-flexible": "^11.1.0",
    "redis": "^4.7.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.7.0",
    "express": ">=4",
    "fastify": ">=4",
    "hono": ">=4",
    "ioredis": ">=5",
    "koa": ">=2",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "koa": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
