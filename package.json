  "files": ["dist", "README.md", "CHANGELOG.md", "STABILITY.md", "BENCH.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "mutation": "stryker run",
    "bench": "tsx bench/run.ts",
    "bench:compare": "tsx bench/compare.ts",
    "bench:gate": "tsx bench/gate.ts",
    "bench:baseline": "tsx bench/gate.ts --update",
    "bench:lens": "tsx bench/lens-taps.ts",
    "bench:lease": "tsx bench/lease.ts",
    "bench:fleet": "tsx server/bench/fleet.ts",
    "bench:check": "tsx server/bench/check.ts",
    "wire:vectors": "tsx wire/generate.ts",
    "wire:scripts": "tsx wire/scripts/generate-scripts.ts",
    "wire": "npm run wire:vectors && npm run wire:scripts",
    "wire:lint": "buf lint",
    "wire:breaking": "buf breaking --against wire/throttlekit.baseline.binpb",
    "wire:baseline": "buf build -o wire/throttlekit.baseline.binpb",
    "wire:check": "npm run wire:lint && npm run wire:breaking",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "publint": "publint",
    "attw": "attw --pack . --profile node16",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:package",
    "check:package": "npm run build && npm run publint && npm run attw",
    "prepublishOnly": "npm run build"
  },
