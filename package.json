{
  "name": "throttlekit",
  "version": "1.7.0",
  "description": "Rate limiting you can prove: a machine-checked, fleet-size-independent overshoot bound on one small core — pure-function algorithms, one atomic store across in-memory/Redis/Postgres (proven bit-identical), a 169ns sync API, and provable two-tier leasing (GALE/TALE).",
  "type": "module",
  "license": "MIT",
  "author": "Ameya Borkar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmeyaBorkar/throttlekit.git"
  },
  "homepage": "https://github.com/AmeyaBorkar/throttlekit#readme",
  "bugs": {
    "url": "https://github.com/AmeyaBorkar/throttlekit/issues"
  },
