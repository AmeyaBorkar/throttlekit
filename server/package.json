{
  "name": "throttlekit-server",
  "version": "0.4.1",
  "description": "gRPC service door for ThrottleKit — run the rate-limiting core as a network service for polyglot clients.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmeyaBorkar/throttlekit.git",
    "directory": "server"
  },
  "homepage": "https://github.com/AmeyaBorkar/throttlekit/tree/main/server#readme",
  "bugs": "https://github.com/AmeyaBorkar/throttlekit/issues",
  "type": "module",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "throttlekit-server": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "proto", "throttlekit.proto", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/bin.js",
    "prepublishOnly": "npm run build",
    "prepack": "node -e \"require('fs').copyFileSync('../wire/throttlekit.proto','throttlekit.proto')\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "ioredis": "^5.4.1",
    "throttlekit": "^1.5.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
