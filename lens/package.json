{
  "name": "throttlekit-lens",
  "version": "0.1.0-experimental.0",
  "description": "ThrottleKit Lens — a zero-dependency, read-only monitoring dashboard for ThrottleKit: live binding-axis attribution plus the full ops board, mountable in your app or run as a sidecar.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmeyaBorkar/throttlekit.git",
    "directory": "lens"
  },
  "homepage": "https://github.com/AmeyaBorkar/throttlekit/tree/main/lens#readme",
  "bugs": "https://github.com/AmeyaBorkar/throttlekit/issues",
  "type": "module",
  "license": "MIT",
  "private": false,
  "keywords": [
    "throttlekit",
    "rate-limit",
    "dashboard",
    "observability",
    "monitoring",
    "binding-axis"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "peerDependencies": {
    "throttlekit": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  }
}
