{
  "title": "ThrottleKit federation \u2014 3-region cluster eval",
  "date": "2026-05-28",
  "setup": {
    "regions": ["us-east", "eu-west", "ap-south"],
    "coordinator": "RedisCoordinator (Redis 7-alpine via docker-compose)",
    "K": 3,
    "fixedConfig": {
      "globalLimit": 300,
      "windowMs_skew_sweep": 5000,
      "windowMs_latency_sweep": 10000,
      "windows": 2,
      "batch_skew_sweep": 8,
      "batch_latency_sweep": 16,
      "offeredMultiplier": 1.0
    },
    "note": "Simulated cross-region latency via in-process LatencyProxy; full Redis-backed Lua coordinator. The cloud-run replacement (real fly.io/GCP cluster) uses the same harness with TK_FED_COORD_URL pointed at a real instance."
  },
